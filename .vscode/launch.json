{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PYTEST: Run all tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/backend",
            "args": ["${workspaceFolder}/backend"]
        },
        {
            "name": "DEBUG: Run frontend",
            "request": "launch",
            "type": "node",
            "runtimeExecutable": "${userHome}/.nvm/versions/node/v16.20.0/bin/npm",
            "runtimeArgs": [
                "--prefix",
                "${workspaceFolder}/frontend",
                "run-script",
                "dev"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "restart": true,
            "console": "integratedTerminal"
        },
        {
            "name": "DEBUG: Run backend",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": [],
            "cwd": "${workspaceFolder}/backend",
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}