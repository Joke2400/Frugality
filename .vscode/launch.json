{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Debug) Browser - Firefox",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "url": "http://localhost:5173/",
            "profile": "debug",
            "webRoot": "${workspaceFolder}/frontend",
            "skipFiles": [
                "${workspaceFolder}/frontend/node_modules/**"
            ],
            "pathMappings": [
                {
                    "url": "webpack:///src/",
                    "path": "${webRoot}/src"
                },
                {
                    "url": "webpack:///node_modules/",
                    "path": "${webRoot}/node_modules"
                },
                {
                    "url": "webpack:///",
                    "path": "${webRoot}"
                },

            ]
        },
        {
            "name": "(Debug) Frontend Local",
            "request": "launch",
            "type": "node",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "--prefix",
                "${workspaceFolder}/frontend",
                "run-script",
                "dev"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "restart": true,
            "console": "integratedTerminal"
        },
        {
            "name": "(Debug) Backend Local",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": [],
            "cwd": "${workspaceFolder}/backend",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "(Debug) Bash Select",
            "type": "bashdb",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${command:SelectScriptName}",
            "terminalKind": "integrated",
            "args": []
        },
        {
            "name": "(Debug): Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/backend",
            "args": [
                "${workspaceFolder}/backend"
            ]
        },
    ]
}